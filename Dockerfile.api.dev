# API development container with auto-restart
FROM node:22-alpine

WORKDIR /app

# Install nodemon globally for auto-restart
RUN npm install -g nodemon

# Copy package files
COPY package.json package-lock.json* ./

# Install all dependencies
RUN npm ci

# Copy server file (will be overridden by volume mount in dev)
COPY server.js ./

# Expose API port
EXPOSE 3001

# Start with nodemon for auto-restart on file changes
CMD ["nodemon", "--watch", "server.js", "--exec", "node", "server.js"]
