---
import BaseLayout from '../layouts/BaseLayout.astro';
import EOSImplementersPageIsland from '../components/EOSImplementersPageIsland.tsx';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'AI Enablement for EOS Implementers',
      description: 'AI enablement for EOS Implementers ready to scale beyond the 20-client ceiling without touching facilitation, the L10 agenda, or the franchise agreement.',
      provider: { '@type': 'Organization', name: 'Ignition Forward' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.ignitionforward.com/' },
        { '@type': 'ListItem', position: 2, name: 'Who We Work With', item: 'https://www.ignitionforward.com/segments' },
        { '@type': 'ListItem', position: 3, name: 'EOS Implementers', item: 'https://www.ignitionforward.com/eos-implementers' },
      ],
    },
  ],
};
---
<BaseLayout
  title="AI for EOS Implementers"
  description="AI enablement for EOS Implementers ready to scale beyond the 20-client ceiling — without touching facilitation, the L10 agenda, or the franchise agreement."
  canonical="/eos-implementers"
  structuredData={structuredData}
>
  <EOSImplementersPageIsland client:load />
</BaseLayout>
