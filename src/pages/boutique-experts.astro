---
import BaseLayout from '../layouts/BaseLayout.astro';
import BoutiqueExpertsPageIsland from '../components/BoutiqueExpertsPageIsland.tsx';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://ignitionforward.com/' },
    { '@type': 'ListItem', position: 2, name: 'Who We Work With', item: 'https://ignitionforward.com/segments' },
    { '@type': 'ListItem', position: 3, name: 'Boutique Expert Teams', item: 'https://ignitionforward.com/boutique-experts' },
  ],
};
---
<BaseLayout
  title="AI for Boutique Expert Teams"
  description="AI systems for expert practices scaling delivery and relationships without diluting quality. Custom solutions for small teams where expertise is the product."
  canonical="/boutique-experts"
  structuredData={structuredData}
>
  <BoutiqueExpertsPageIsland client:load />
</BaseLayout>
