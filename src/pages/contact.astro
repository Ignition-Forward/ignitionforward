---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactPageIsland from '../components/ContactPageIsland.tsx';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://ignitionforward.com/' },
    { '@type': 'ListItem', position: 2, name: 'Contact', item: 'https://ignitionforward.com/contact' },
  ],
};
---
<BaseLayout
  title="Contact Us"
  description="Contact Ignition Forward. Two clicks, one field. We'll find time to talk within 48 hours."
  canonical="/contact"
  structuredData={structuredData}
>
  <ContactPageIsland client:load />
</BaseLayout>
