# Resend API for contact form emails
RESEND_API_KEY=re_your_api_key_here

# Email address to receive contact form submissions (optional)
CONTACT_TO_EMAIL=hello@ignitionforward.com

# Supabase for contact form tracking
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# API server configuration
API_PORT=3001

# Frontend API URL (for production, set to your deployed API URL)
VITE_API_URL=http://localhost:3001
